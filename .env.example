# ── ATLAS Scanner Inteligente – variáveis de ambiente ──────────
# Copie este arquivo para .env e ajuste os valores

# Liga o scanner ao iniciar (true/false)
ATLAS_SCANNER_ENABLED=false

# Intervalo de varredura em SEGUNDOS (padrão 300 = 5 min)
ATLAS_SCANNER_INTERVAL_SECONDS=300

# Timeframe padrão
ATLAS_SCANNER_TIMEFRAME=5m

# Ativos monitorados (separados por vírgula)
ATLAS_SCANNER_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Score mínimo para emitir alerta (0.0 a 1.0)
ATLAS_SCANNER_MIN_SCORE=0.58

# Cooldown entre alertas do mesmo ativo (segundos)
ATLAS_SCANNER_COOLDOWN_SECONDS=900

# Chat ID do Telegram para receber alertas
TELEGRAM_CHAT_ID=123456789
