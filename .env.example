# ── ATLAS Scanner Inteligente – variáveis de ambiente ──────────
# Copie este arquivo para .env e ajuste os valores

# Liga o scanner ao iniciar (true/false)
ATLAS_SCANNER_ENABLED=false

# Intervalo de varredura em SEGUNDOS (padrão 300 = 5 min)
ATLAS_SCANNER_INTERVAL_SECONDS=300

# Timeframe padrão
ATLAS_SCANNER_TIMEFRAME=5m

# Ativos monitorados (separados por vírgula)
ATLAS_SCANNER_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Score mínimo para emitir alerta (0.0 a 1.0)
ATLAS_SCANNER_MIN_SCORE=0.58

# Cooldown entre alertas do mesmo ativo (segundos)
ATLAS_SCANNER_COOLDOWN_SECONDS=900

# Chat ID do Telegram para receber alertas
TELEGRAM_CHAT_ID=123456789

# ═════════════════════════════════════════════════════════════════
# SISTEMA ATLAS — Thresholds de Confluência & Calibração
# ═════════════════════════════════════════════════════════════════

# Thresholds mínimos de score e confluência para entrada
ATLAS_MIN_SCORE=0.50
ATLAS_MIN_CONFLUENCE=3
ATLAS_STRONG_MIN_SCORE=0.62
ATLAS_STRONG_MIN_CONFLUENCE=4
ATLAS_WEAK_MIN_SCORE=0.42
ATLAS_WEAK_MIN_CONFLUENCE=3

# Parâmetros técnicos de cálculo do score
ATLAS_ACTIVE_TECHNIQUE_MIN_SCORE=0.20
ATLAS_AGREEMENT_THRESHOLD=0.30
ATLAS_COVERAGE_BASE=0.80
ATLAS_COVERAGE_SLOPE=0.20
ATLAS_AGREEMENT_BONUS_STEP=0.06

# Parâmetros de calibração logística (normalização final)
ATLAS_CALIB_K=6.0
ATLAS_CALIB_CENTER=0.42

# Thresholds de ADX
ATLAS_ADX_MIN=12
ATLAS_ADX_STRONG=15

# Shadow Mode — coleta de dados para calibração
ATLAS_SHADOW_MODE=0
ATLAS_SHADOW_LOG=/tmp/atlas_shadow.jsonl

# ═════════════════════════════════════════════════════════════════
# Gates Finais — Tolerância e Compensação
# ═════════════════════════════════════════════════════════════════

# Tolerância de edge (permite sinal com edge ligeiramente abaixo do min)
ATLAS_EDGE_TOLERANCE=0.005

# Compensação de probabilidade (prob alta pode compensar edge baixo)
ATLAS_PROB_COMPENSATION=5.0

# Fator de compensação de edge (se prob+consenso muito bons, relaxar edge)
ATLAS_EDGE_COMPENSATION_FACTOR=0.50

# Score mínimo de setup (base)
ATLAS_MIN_SETUP_SCORE=4

# Anti-spam: máximo de sinais por ativo em 1 hora
MONITOR_MAX_SIGNALS_PER_SYMBOL_HOUR=2

# Scanner dinâmico de ativos (preparado para fase futura)
MONITOR_DYNAMIC_SYMBOLS=0
MONITOR_MAX_DYNAMIC_SYMBOLS=20
MONITOR_MIN_QUOTE_VOLUME=1000000

# ═════════════════════════════════════════════════════════════════
# Stockity/Binomo — Crypto IDX (opções binárias via WebSocket)
# ═════════════════════════════════════════════════════════════════

# Liga o hook automático após sinal ATLAS aprovado (true/false)
STOCKITY_EXECUTOR_ENABLED=false

# Habilita o executor internamente (necessário além do hook acima)
STOCKITY_ENABLED=false

# demo (conta demo) ou live (dinheiro real)
STOCKITY_MODE=demo

# Segunda trava obrigatória para operar com dinheiro real
STOCKITY_CONFIRM_LIVE=false

# stockity.id ou binomo2.com
STOCKITY_PLATFORM=stockity.com

# Credenciais da conta na corretora (NÃO faça commit de valores reais)
STOCKITY_EMAIL=
STOCKITY_PASSWORD=

# Valor da entrada em centavos (500 = R$ 5,00)
STOCKITY_DEFAULT_AMOUNT_CENTS=500

# Expiração da opção em minutos
STOCKITY_DEFAULT_EXPIRATION_MINUTES=1

# Ativo padrão negociado (Crypto IDX)
STOCKITY_DEFAULT_ASSET_RIC=Z-CRY/IDX

# ATLAS Crypto IDX (Rejeição) — /atlas_cryptoidx, /atlas_cryptoidx_auto, /atlas_cryptoidx_quality
# Intervalo do scanner automático em segundos
ATLAS_CRYPTOIDX_SCAN_INTERVAL_SECONDS=60
# Qualidade mínima (A|B|C) que gera alerta no auto-scan; execução automática
# na Stockity sempre exige qualidade A + AÇÃO=ENTRAR, independente deste valor.
ATLAS_CRYPTOIDX_MIN_QUALITY=B

